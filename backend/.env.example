MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=anime_db
MONGODB_ANIME_COLLECTION=anime
MONGODB_DOMAIN_COLLECTION=discovered_domains

INTERNAL_API_KEY=replace-with-a-strong-internal-api-key
ADMIN_API_KEY=replace-with-a-strong-admin-api-key

PUBLIC_API_RATE_LIMIT_PER_MINUTE=60

LOG_LEVEL=INFO
MAX_DEPTH=3
POSTER_DIR=posters
POSTER_MIN_WIDTH=200
POSTER_MIN_HEIGHT=300
POSTER_TIMEOUT=15
